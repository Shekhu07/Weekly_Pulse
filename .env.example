# Weekly Product Review Pulse — Environment Variables
# Copy this file to .env and fill in real values.

# === LLM (Groq — for theme summarization) ===
GROQ_API_KEY=your_groq_api_key_here

# === Embeddings ===
# Embeddings use BAAI/bge-small-en-v1.5 via sentence-transformers (local, no API key needed).
# The model (~80 MB) is downloaded once to your HuggingFace cache on first run.

# === MCP Server ===
MCP_SERVER_URL=https://your-mcp-server-url.example.com
MCP_API_KEY=your_api_key_here

# === Google Docs target ===
# Used when config/products/<product>.yaml still has the google_doc_id placeholder.
GOOGLE_DOC_ID=your_google_doc_id_here

# === Optional Overrides ===
# PULSE_EMAIL_MODE=draft        # draft | send (overrides product config)
# PULSE_DRY_RUN=false           # true to skip MCP writes
# PULSE_EMAIL_RECIPIENTS=a@corp.com,b@corp.com   # overrides placeholder recipients in product config
